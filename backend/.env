PORT=4000
SHOP_OPEN_HOUR=6
SHOP_CLOSE_HOUR=22
MAX_CONCURRENT_APPOINTMENTS=2
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional: when set, admin endpoints require header x-admin-api-key
# ADMIN_API_KEY=change-me
# Optional: admin account login (POST /api/v1/auth/admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
ADMIN_TOKEN_TTL_MINUTES=720
ADMIN_AUTH_SECRET=

BOOKING_DB_PATH=./data/booking-db.json
